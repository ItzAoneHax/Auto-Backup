# ============================================================
# Auto-Backup 配置文件模板
# 使用方法: 复制为同目录下的 application.properties 并按需修改
#   cp application.properties.example application.properties
# 所有以 # 开头的行均为注释, 未注释的行都有默认值或必填说明
# ============================================================

# ---------- 百度网盘开放平台凭证(必填) ----------
# 在 https://pan.baidu.com/union/console 的应用详情中查看
pan.appKey=填写你的AppKey
pan.secretKey=填写你的SecretKey

# 远程备份根目录(必填)
# 个人应用只能访问自己的应用目录, 一般为 /apps/你的应用目录名
# (应用目录名在控制台"基本资料"中, 不是应用名称)
pan.remoteDir=/apps/你的应用目录名

# ---------- 备份策略 ----------
# 要备份的本地目录, 多个用英文逗号分隔
# 每个目录会各自打包成一个独立的 tar.gz
backup.sources=/data

# 打包时排除的文件, glob 语法(匹配归档内相对路径), 多个用逗号分隔
# 示例: 排除所有 .tmp 文件和 cache 目录下所有内容
#backup.excludes=*.tmp,cache/**

# 每日备份触发时间(daemon 模式下生效, 24 小时制 HH:mm)
backup.dailyTime=03:00

# 云端 daily 目录保留天数(至多留存近 N 天, 含日志文件)
# 注意: 增量备份开启时, 实际保留天数会自动取
#   max(保留天数, 全量间隔天数 + 2)
# 以保证"最近一次全量 + 其后增量"的恢复链始终完整
backup.retainDays=3

# 每年第一次成功备份时, 在云端复制一份到 yearly 目录永久保留
backup.yearly.enabled=true

# 每月第一次成功备份时, 在云端复制一份到 monthly 目录永久保留
# (快照为服务端复制, 不产生上传流量; 留意长期累积的容量占用)
backup.monthly.enabled=true

# ---------- 本地文件 ----------
# 打包临时目录(上传成功后自动清理归档文件)
backup.workDir=./work

# 本地运行日志目录
backup.logDir=./logs

# 本地日志保留天数
backup.logRetainDays=30

# 上传成功后删除本地归档文件(false 则保留在 workDir 中)
backup.deleteLocalArchive=true

# ---------- 增量备份(可选提速模式, 默认关闭) ----------
# 默认每天全量: 每个服务器每天在云端就是一个完整的 .tar.zst, 下载解压即用。
# 开启后每天只打包与上次相比有变化(新增/修改)的文件, 显著减少上传时间;
# 每隔 fullIntervalDays 天做一次全量; 程序会把"最近一次全量 + 其后增量"云端复制
# (零上传流量)进当天的日期文件夹, 因此任意一天的日期文件夹仍是自包含的,
# 下载后把服务器子文件夹里的全部归档按文件名顺序解压即得当日完整服务端:
#   for f in xxx-*.tar.zst; do tar --zstd -xf "$f"; done
# 月度/年度快照目录为空时会自动强制全量, 保证快照可独立恢复。
backup.incremental.enabled=false

# 两次全量备份的间隔天数(1-365)
backup.incremental.fullIntervalDays=7

# ---------- 压缩算法 ----------
# tar 归档的压缩算法: zstd(默认, 多线程, 数百 MB/s)或 gzip(兼容旧版, 单线程)
# zstd 归档后缀为 .tar.zst, 解压: tar --zstd -xf xxx.tar.zst (需系统装有 zstd)
# gzip 归档后缀为 .tar.gz, 解压: tar -xzf xxx.tar.gz
archive.compressor=zstd

# zstd 压缩级别 1-22, 常用 3: 速度与压缩率的平衡点, 数值越大压缩越狠但越慢
archive.zstdLevel=3

# zstd 压缩线程数, 0 = 自动取 CPU 核数
archive.zstdWorkers=0

# ---------- 上传参数 ----------
# 分片大小(MB)。官方限制与账号等级挂钩:
#   普通用户: 分片固定 4MB, 单文件上限 4GB
#   会员:     分片最大 16MB, 单文件上限 10GB
#   超级会员: 分片最大 32MB, 单文件上限 20GB
# 普通用户请保持默认值 4
upload.chunkSizeMB=4

# 分片上传失败重试次数
upload.retries=3

# 分片并发上传数(1-16)。官方 FAQ 明确支持分片并发, 能明显缩短大文件上传时间;
# 并发越高失败率越高(已有分片级重试兜底), 建议 4-8, 观察日志中的失败重试再调整
upload.parallelChunks=4

# ---------- 归档分卷 ----------
# 单个分卷的最大体积(MB), 0 表示不分卷。
# 网盘对"单个文件"有大小上限(普通用户 4GB / 会员 10GB / 超级会员 20GB),
# 分片上传只是传输方式, 不能突破该上限; 开启分卷后, 超过分卷大小的归档
# 会切成 xxx.tar.gz.part001、xxx.tar.gz.part002... 多个文件分别上传;
# 未超过分卷大小的归档仍是一个完整的 xxx.tar.gz(不带分卷后缀, 下载后可直接解压)。
# 多分卷恢复方法: 按序号拼接后再解压, 如
#   Linux/Git Bash: cat xxx.tar.gz.part* > full.tar.gz
#   Windows cmd:   copy /b xxx.tar.gz.part001+xxx.tar.gz.part002 full.tar.gz
# 建议略低于账号上限留出余量: 普通用户 3900 / 会员 9500 / 超级会员 19500
upload.splitSizeMB=0
